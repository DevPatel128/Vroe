{
  "name": "vroe-labs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vroe Labs \u2014 product studio website. Prerendered static site on Cloudflare Workers.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:fonts && npm run build:images && vite build && npm run build:prerender && npm run build:seo",
    "build:images": "node scripts/optimize-images.mjs",
    "build:prerender": "node scripts/prerender.mjs",
    "build:seo": "node scripts/generate-sitemap.mjs",
    "build:og": "node scripts/generate-og.mjs",
    "build:icons": "node scripts/generate-icons.mjs",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "npm run test:sites && npm run test:security && npm run test:functionality && npm run test:seo && npm run test:evidence && npm run test:performance && npm run test:docs && npm run test:accessibility && npm run test:docs-sync && npm run test:docs-impact && npm run test:backup",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:security": "node --test tests/security.test.mjs",
    "test:functionality": "node --test tests/functionality.test.mjs",
    "test:seo": "node --test tests/seo.test.mjs",
    "test:evidence": "node --test tests/evidence.test.mjs",
    "test:performance": "node --test tests/performance.test.mjs",
    "test:docs": "node --test tests/docs.test.mjs",
    "test:accessibility": "node --test tests/accessibility.test.mjs",
    "test:docs-sync": "node --test tests/docs-sync.test.mjs",
    "test:docs-impact": "node --test tests/docs-impact.test.mjs",
    "test:backup": "node --test tests/backup.test.mjs",
    "backup": "node scripts/backup-subscribers.mjs",
    "backup:check": "node scripts/backup-subscribers.mjs --check",
    "perf": "node perf/run.mjs",
    "audit:deps": "npm audit --audit-level=high",
    "audit:sbom": "npm sbom --sbom-format cyclonedx --omit dev > sbom.json",
    "build:fonts": "node scripts/sync-fonts.mjs"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "opentype.js": "2.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  }
}
