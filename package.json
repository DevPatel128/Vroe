{
  "name": "vroe-labs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vroe Labs — product studio website. Prerendered static site on Cloudflare Workers.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:fonts && npm run build:images && vite build && npm run build:prerender && npm run build:seo",
    "build:images": "node scripts/optimize-images.mjs",
    "build:prerender": "node scripts/prerender.mjs",
    "build:seo": "node scripts/generate-sitemap.mjs",
    "build:og": "node scripts/generate-og.mjs",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "npm run test:sites && npm run test:security && npm run test:seo",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:security": "node --test tests/security.test.mjs",
    "test:seo": "node --test tests/seo.test.mjs",
    "audit:deps": "npm audit --audit-level=high",
    "audit:sbom": "npm sbom --sbom-format cyclonedx --omit dev > sbom.json",
    "build:fonts": "node scripts/sync-fonts.mjs"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "opentype.js": "2.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.35.4",
    "vite": "6.4.3",
    "wrangler": "4.127.1"
  }
}
