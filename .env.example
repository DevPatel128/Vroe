# Vroe Labs — environment reference
#
# This file documents variable NAMES only. It contains no real values and is
# safe to commit. Nothing here is read at build time; the site is fully static.
#
# WHERE VALUES ACTUALLY LIVE
# --------------------------
#   Public, non-secret      -> "vars" in wrangler.jsonc (committed)
#   Secret                  -> npx wrangler secret put <NAME>  (never committed)
#   Local development       -> .dev.vars (gitignored)
#   CI                      -> GitHub Actions repository secrets

# ─── Public. Safe in source and visible in the page. ───────────────────────
# Cloudflare Turnstile SITE key. Public by design — it appears in the page
# source of every site that uses Turnstile. Set in wrangler.jsonc "vars".
TURNSTILE_SITE_KEY="0x0000000000000000000000"

# Cloudflare Web Analytics beacon token. Public; grants no read access to the
# analytics data. Set in src/content/site.js as CF_ANALYTICS_TOKEN.
CF_ANALYTICS_TOKEN=""

# Google Search Console HTML-tag verification. Only needed if you are not using
# the DNS TXT method. Set in src/content/site.js.
GOOGLE_SITE_VERIFICATION=""

# ─── Secret. Never commit a real value for any of these. ───────────────────
# Turnstile SECRET key. Verifies tokens server-side.
#   npx wrangler secret put TURNSTILE_SECRET_KEY
TURNSTILE_SECRET_KEY=""

# Cloudflare API token used by GitHub Actions to deploy. Scoped to:
#   Workers Scripts:Edit, Workers KV Storage:Edit,
#   Account Settings:Read, Zone:Workers Routes:Edit (vroelabs.com)
# Stored as a GitHub Actions repository secret, never in this repo.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# ─── Not used yet. Listed so nobody wires them in without reading SECURITY.md.
# Adding any of these means the privacy policy must be updated first.
# RESEND_API_KEY=""     # transactional email / double opt-in
# SENTRY_DSN=""         # error aggregation
# POSTHOG_KEY=""        # product analytics
